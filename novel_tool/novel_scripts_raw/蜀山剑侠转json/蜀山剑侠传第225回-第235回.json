    {
      "id": 20,
      "role": "陷空老祖",
      "api": {
        "voice": {
          "role": "陷空老祖",
          "role_voice": "云森-沧桑男声,忧郁深邃",
          "speed": "-6%",
          "volume": "0%",
          "pitch": "-4Hz",
          "text": "我与令师只是神交，易贤侄的令尊与我交厚，虽是后辈，先来已然礼拜，此时毋须太谦。我僻居极荒，终日静坐，久习疏懒。各方道友来访，多不离座，只以奏乐迎送，也不作客套。请各就座吧。",
          "instruct": "淡然而带威严"
        },
        "effects": []
